{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kubecon-planner",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "build": { "command": "npm run build:client" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/admin", "/export/*", "/notify/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kubecon-planner",
      "database_id": "9bea4893-cf92-41d6-8829-693d35e4e206",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OAUTH_CLIENT_ID": "eb7ddd2a8912ec6fe245dc7ac2fabf31",
    "ALLOWED_EMAILS": "",
    "APP_ORIGIN": "https://kubecon-planner.cloud-app-asdf.workers.dev"
  },
  "observability": { "enabled": true },
  // Nightly at 06:00 UTC = midnight Central (CST): refresh the schedule and send email summaries.
  // src/summaries.ts limits runs to 7 nights (Central dates 2026-11-13 to 2026-11-19).
  "triggers": { "crons": ["0 6 * * *"] },
  // Email Service binding; may only send from the planner address on shareplay.com.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["planner@shareplay.com"] }]
}
