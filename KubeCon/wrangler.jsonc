{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kubecon-planner",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "build": { "command": "npm run build:client" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/admin"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kubecon-planner",
      "database_id": "9bea4893-cf92-41d6-8829-693d35e4e206",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OAUTH_CLIENT_ID": "eb7ddd2a8912ec6fe245dc7ac2fabf31",
    "ALLOWED_EMAILS": ""
  },
  "observability": { "enabled": true }
}
