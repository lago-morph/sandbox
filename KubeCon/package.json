{
  "name": "kubecon-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build:client": "esbuild src/client/app.ts --bundle --format=esm --outfile=public/app.js --target=es2020",
    "deploy": "npm run build:client && node scripts/deploy.mjs",
    "smoke": "NODE_USE_ENV_PROXY=1 node scripts/smoke.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0"
  }
}
